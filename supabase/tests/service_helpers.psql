-- Helper uji domain servis. Di-include dengan \ir dari service_*.sql (bukan berkas uji mandiri).
-- Semua objek dibuat di pg_temp dalam transaksi uji yang di-rollback.

create function pg_temp.as_user(p_who text) returns void language sql as $$
  select set_config('request.jwt.claim.sub', case p_who
    when 'owner' then '11111111-1111-4111-8111-111111111111'
    when 'staff' then '22222222-2222-4222-8222-222222222222'
    when 'maint' then '33333333-3333-4333-8333-333333333333'
    when 'off' then '44444444-4444-4444-8444-444444444444' end, true)
$$;

-- Panggil RPC; operation_id acak ditambahkan bila belum ada.
create function pg_temp.call(p_fn text, p_input jsonb) returns jsonb language plpgsql as $$
declare v jsonb;
begin
  if p_fn not in ('get_service_ticket_v1', 'list_service_tickets_v1', 'get_service_payment_status_v1',
      'search_customers_v1', 'find_similar_customers_v1', 'list_customer_history_v1', 'get_operation_v1')
     and not (p_input ? 'operation_id') then
    p_input := p_input || jsonb_build_object('operation_id', gen_random_uuid());
  end if;
  execute format('select public.%I($1)', p_fn) into v using p_input;
  return v;
end $$;

-- Harapkan gagal dengan kode tertentu (awal pesan 'KODE:').
create function pg_temp.fail(p_fn text, p_input jsonb, p_code text) returns void language plpgsql as $$
begin
  begin
    perform pg_temp.call(p_fn, p_input);
  exception when others then
    if position(p_code || ':' in sqlerrm) = 1 then return; end if;
    raise exception 'Harapan % pada %, dapat: %', p_code, p_fn, sqlerrm;
  end;
  raise exception 'Harapan % pada %, tetapi berhasil', p_code, p_fn;
end $$;

create function pg_temp.check(p_ok boolean, p_msg text) returns void language plpgsql as $$
begin
  if p_ok is not true then raise exception 'GAGAL: %', p_msg; end if;
end $$;

create function pg_temp.ver(p_ticket uuid) returns integer language sql as $$
  select version from private.service_tickets where id = p_ticket
$$;

create function pg_temp.state(p_ticket uuid) returns jsonb language sql as $$
  select public.get_service_payment_status_v1(jsonb_build_object('ticket_id', p_ticket))
$$;

-- Tiket titip toko (owner kecuali diubah).
create function pg_temp.new_store_ticket(p_name text default 'Pelanggan Uji', p_phone text default '081200001111')
returns uuid language plpgsql as $$
declare v jsonb;
begin
  v := pg_temp.call('create_service_ticket_v1', jsonb_build_object(
    'customer_name', p_name, 'customer_phone', p_phone, 'equipment_type', 'TV',
    'complaint', 'Mati total', 'initial_condition', 'Casing baret', 'service_location', 'STORE'));
  return (v->>'entity_id')::uuid;
end $$;

-- Estimasi + persetujuan + WORKING (owner).
create function pg_temp.to_working(p_ticket uuid, p_max text, p_limit text) returns void language plpgsql as $$
declare v jsonb;
begin
  perform pg_temp.as_user('owner');
  v := pg_temp.call('record_estimate_v1', jsonb_build_object('ticket_id', p_ticket,
    'expected_version', pg_temp.ver(p_ticket), 'description', 'Perbaikan', 'max_amount', p_max));
  perform pg_temp.call('approve_estimate_v1', jsonb_build_object('estimate_id', v->>'estimate_id',
    'expected_version', 1, 'agreed_limit', p_limit, 'method', 'PHONE'));
  perform pg_temp.call('transition_service_v1', jsonb_build_object('ticket_id', p_ticket,
    'expected_version', pg_temp.ver(p_ticket), 'target_status', 'WORKING'));
end $$;

create function pg_temp.set_status(p_ticket uuid, p_status text, p_extra jsonb default '{}') returns jsonb
language sql as $$
  select pg_temp.call('transition_service_v1', jsonb_build_object('ticket_id', p_ticket,
    'expected_version', pg_temp.ver(p_ticket), 'target_status', p_status) || p_extra)
$$;

create function pg_temp.finalize(p_ticket uuid, p_lines jsonb, p_extra jsonb default '{}') returns jsonb
language sql as $$
  select pg_temp.call('finalize_service_invoice_v1', jsonb_build_object('ticket_id', p_ticket,
    'expected_version', pg_temp.ver(p_ticket), 'charge_lines', p_lines) || p_extra)
$$;

create function pg_temp.labor(p_amount text) returns jsonb language sql as $$
  select jsonb_build_array(jsonb_build_object('kind', 'LABOR', 'description', 'Jasa', 'quantity', '1', 'unit_price', p_amount))
$$;

create function pg_temp.open_cash(p_box text, p_amount numeric) returns uuid language sql as $$
  insert into private.cash_sessions(cashbox_id, opened_by, business_date, opening_amount)
  values (p_box, '11111111-1111-4111-8111-111111111111', current_date, p_amount) returning id
$$;

create function pg_temp.cash_expected(p_box text) returns numeric language sql as $$
  select private.cash_session_expected(id) from private.cash_sessions where cashbox_id = p_box and status = 'OPEN'
$$;
