-- Helper uji domain penjualan/katalog. Disertakan via \ir dari berkas sales_*.sql
-- setelah `begin;`, sehingga seluruh fixture ikut di-rollback.
-- Fixture dibuat langsung di tabel (bukan lewat RPC stok/kas milik domain lain)
-- agar uji penjualan tidak bergantung pada kontrak domain lain.

create function pg_temp.uid(p_user text) returns uuid language sql immutable as $$
  select case p_user
    when 'owner' then '11111111-1111-4111-8111-111111111111'
    when 'staff' then '22222222-2222-4222-8222-222222222222'
    when 'maintainer' then '33333333-3333-4333-8333-333333333333'
    when 'disabled' then '44444444-4444-4444-8444-444444444444'
  end::uuid
$$;

create function pg_temp.act(p_user text) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claim.sub', pg_temp.uid(p_user)::text, true);
end $$;

-- Panggil RPC publik sebagai user tertentu.
create function pg_temp.call(p_user text, p_fn text, p_input jsonb) returns jsonb language plpgsql as $$
declare v jsonb;
begin
  perform pg_temp.act(p_user);
  execute format('select public.%I($1)', p_fn) into v using p_input;
  return v;
end $$;

-- Harus gagal dengan kode error tertentu (awalan pesan 'KODE:').
create function pg_temp.expect_error(p_user text, p_fn text, p_input jsonb, p_code text) returns void
language plpgsql as $$
declare v_msg text;
begin
  perform pg_temp.act(p_user);
  begin
    execute format('select public.%I($1)', p_fn) using p_input;
  exception when others then
    v_msg := sqlerrm;
  end;
  if v_msg is null then
    raise exception 'UJI GAGAL: % sebagai % seharusnya ditolak %, tetapi sukses', p_fn, p_user, p_code;
  end if;
  if v_msg <> p_code and position(p_code || ':' in v_msg) <> 1 then
    raise exception 'UJI GAGAL: % sebagai % diharapkan %, dapat: %', p_fn, p_user, p_code, v_msg;
  end if;
end $$;

create function pg_temp.assert(p_ok boolean, p_msg text) returns void language plpgsql as $$
begin
  if p_ok is not true then raise exception 'UJI GAGAL: %', p_msg; end if;
end $$;

create function pg_temp.eq(p_actual anyelement, p_expected anyelement, p_msg text) returns void language plpgsql as $$
begin
  if p_actual is distinct from p_expected then
    raise exception 'UJI GAGAL: % (dapat %, harap %)', p_msg, p_actual, p_expected;
  end if;
end $$;

create function pg_temp.product(p_sku text, p_base text, p_step numeric, p_track boolean) returns uuid
language sql as $$
  insert into private.products(sku, name, base_unit, quantity_step, track_segments)
  values (p_sku, 'Uji ' || p_sku, p_base, p_step, p_track) returning id
$$;

create function pg_temp.unit(p_product uuid, p_label text, p_factor numeric, p_step numeric, p_price numeric,
  p_default boolean default true) returns uuid language sql as $$
  insert into private.product_units(product_id, label, factor_base, sale_step, sell_price, is_default)
  values (p_product, p_label, p_factor, p_step, p_price, p_default) returning id
$$;

-- Satu lot + satu posisi + movement pembuka yang konsisten dengan ledger. Mengembalikan position_id.
create function pg_temp.stock(p_product uuid, p_qty numeric, p_cost numeric, p_posted timestamptz,
  p_label text default null, p_capacity numeric default null, p_sealed boolean default false,
  p_location text default 'SHOP', p_condition text default 'SALEABLE') returns uuid
language plpgsql as $$
declare v_doc uuid; v_item uuid; v_lot uuid; v_pos uuid; v_op uuid := gen_random_uuid();
begin
  insert into private.stock_documents(number, kind, posted_at, actor_id, reason, operation_id)
  values ('UJI-' || v_op, 'OPENING', p_posted, pg_temp.uid('owner'), 'fixture uji', v_op) returning id into v_doc;
  insert into private.stock_document_items(document_id, line_no, product_id, unit_snapshot, qty_input,
    factor_snapshot, qty_base, acquisition_cost, destination_location, condition)
  values (v_doc, 1, p_product, 'dasar', p_qty, 1, p_qty, p_cost, p_location, p_condition) returning id into v_item;
  insert into private.inventory_lots(product_id, origin_item_id, posted_at, original_qty, original_cost,
    remaining_qty, remaining_cost)
  values (p_product, v_item, p_posted, p_qty, p_cost, p_qty, p_cost) returning id into v_lot;
  insert into private.stock_positions(lot_id, location, condition, qty_base, label, segment_capacity, sealed)
  values (v_lot, p_location, p_condition, p_qty, p_label, p_capacity, p_sealed) returning id into v_pos;
  insert into private.stock_movements(group_id, lot_id, position_id, qty_delta, cost_delta, kind,
    stock_document_item_id, actor_id, operation_id, occurred_at)
  values (v_doc, v_lot, v_pos, p_qty, p_cost, 'OPENING', v_item, pg_temp.uid('owner'), v_op, p_posted);
  return v_pos;
end $$;

create function pg_temp.lot_of(p_position uuid) returns uuid language sql as $$
  select lot_id from private.stock_positions where id = p_position
$$;

create function pg_temp.open_drawer(p_amount numeric) returns uuid language sql as $$
  insert into private.cash_sessions(cashbox_id, opened_by, business_date, opening_amount)
  values ('SHOP_DRAWER', '11111111-1111-4111-8111-111111111111', current_date, p_amount) returning id
$$;

create function pg_temp.drawer_expected() returns numeric language sql as $$
  select private.cash_session_expected(id) from private.cash_sessions
  where cashbox_id = 'SHOP_DRAWER' and status = 'OPEN'
$$;

create function pg_temp.op() returns text language sql as $$ select gen_random_uuid()::text $$;

-- Invariant BR-14 untuk seluruh data dalam transaksi uji.
create function pg_temp.check_invariants() returns void language plpgsql as $$
declare v_bad integer;
begin
  select count(*) into v_bad from private.inventory_lots l
    where l.remaining_qty <> (select coalesce(sum(p.qty_base), 0) from private.stock_positions p where p.lot_id = l.id)
       or l.remaining_cost <> (select coalesce(sum(m.cost_delta), 0) from private.stock_movements m where m.lot_id = l.id)
       or l.remaining_qty < 0 or l.remaining_cost < 0
       or (l.remaining_qty = 0 and l.remaining_cost <> 0);
  perform pg_temp.eq(v_bad, 0::bigint::integer, 'invariant lot = posisi = ledger');
  select count(*) into v_bad from private.stock_positions p
    where p.qty_base <> (select coalesce(sum(m.qty_delta), 0) from private.stock_movements m where m.position_id = p.id);
  perform pg_temp.eq(v_bad, 0, 'invariant posisi = ledger qty');
  select count(*) into v_bad from private.invoices i
    where i.total <> (select coalesce(sum(ii.net_total), 0) from private.invoice_items ii where ii.invoice_id = i.id)
       or i.discount_total <> (select coalesce(sum(ii.invoice_discount_alloc), 0) from private.invoice_items ii where ii.invoice_id = i.id)
       or i.subtotal_net_lines <> (select coalesce(sum(ii.base_net), 0) from private.invoice_items ii where ii.invoice_id = i.id)
       or i.total <> i.subtotal_net_lines - i.discount_total;
  perform pg_temp.eq(v_bad, 0, 'invariant total nota = jumlah baris');
  select count(*) into v_bad from private.invoice_items ii
    where ii.kind = 'PRODUCT' and ii.qty_base <> (select coalesce(sum(ca.qty_base), 0)
      from private.cost_allocations ca where ca.invoice_item_id = ii.id);
  perform pg_temp.eq(v_bad, 0, 'invariant qty nota = qty alokasi stok');
  select count(*) into v_bad from private.cost_allocations
    where reversed_qty > qty_base or reversed_cost > cost_amount or reversed_qty < 0 or reversed_cost < 0;
  perform pg_temp.eq(v_bad, 0, 'invariant pembalikan <= alokasi');
  select count(*) into v_bad from private.payments p
    where p.direction = 'IN' and p.purpose = 'SALE_RECEIPT'
      and p.amount < (select coalesce(sum(ra.amount), 0) from private.refund_allocations ra where ra.original_payment_id = p.id);
  perform pg_temp.eq(v_bad, 0, 'invariant refund <= receipt');
  select count(*) into v_bad from private.payments p
    where p.purpose = 'CUSTOMER_REFUND' and p.invoice_id is not null
      and p.amount <> (select coalesce(sum(ra.amount), 0) from private.refund_allocations ra where ra.refund_payment_id = p.id);
  perform pg_temp.eq(v_bad, 0, 'invariant refund teralokasi penuh');
end $$;
